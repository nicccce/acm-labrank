# pnpm setup generates local random credentials. Never commit .env or .secrets.
ACM_IMAGE_REPOSITORY=nicccce/acm-labrank
ACM_IMAGE_TAG=1.1.0
APP_URL=http://localhost:3000
WEB_BIND_PORT=3000
POSTGRES_DB=acm
POSTGRES_USER=acm
POSTGRES_PASSWORD=replace-with-random-password
# URL-encode credentials; local development uses compose.dev.yaml on port 5433.
DATABASE_URL=postgresql://acm:replace-with-random-password@127.0.0.1:5433/acm
SESSION_ENCRYPTION_KEY_FILE=./.secrets/session-encryption-key
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD_FILE=./.secrets/admin-bootstrap-password
TZ=UTC
# Seeds the missing database auto-sync setting only; edit running settings in /admin/collection.
SYNC_ENABLED=false
# Optional Docker Desktop egress through an existing host HTTP proxy.
# NODE_USE_ENV_PROXY=1
# PLATFORM_HTTPS_PROXY=http://host.docker.internal:7890
CF_MIN_INTERVAL_MS=2000
QOJ_MIN_INTERVAL_MS=3000
# The interval variables only seed missing database policies during migration.
# Subsequent changes use PATCH /api/admin/platforms/:platform/rate-limit.
LUOGU_MIN_INTERVAL_MS=3000
LUOGU_CONNECTION_ID=luogu-lab
QOJ_TRANSPORT=node
QOJ_CONNECTION_ID=qoj-lab
QOJ_VNC_URL=http://localhost:6080/vnc.html?autoconnect=1&resize=scale
QOJ_BROWSER_HEADED=true
# Optional: QOJ_BROWSER_CHANNEL=msedge (otherwise try installed Edge, Chrome, Chromium).
QOJ_HTTP_TIMEOUT_MS=30000
QOJ_HTTP_RETRIES=2
QOJ_HUMAN_TIMEOUT_MS=120000
QOJ_HUMAN_RETRIES=2
# Local operator confirmation only: {"id":"reported challenge id","confirmed":true}
# QOJ_HUMAN_CONFIRM_FILE=.local/qoj-confirm.json
# QOJ_LOGIN_HANDLE=dedicated-collecting-account
# The standard worker image includes the container-owned Chromium desktop.
# QOJ_DESKTOP_PORT=6080 (host loopback only; use an SSH tunnel for a remote server).
# QOJ_VNC_PASSWORD_FILE=./.secrets/qoj-vnc-password (generated by setup, never in argv).
# QOJ_BROWSER_PROXY_SERVER=http://approved-proxy:port (optional standard Chromium proxy; direct access is the default).
# QOJ_BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222 (optional, loopback only; container sets this internally).
# QOJ_BROWSER_MANUAL_START=true (optional: wait for single-use local confirmation before Worker attaches).
# QOJ_BROWSER_START_TARGET=muhammad (dedicated browser's first profile URL in manual-start mode).
